###############################################################################
# Sinaptik Analytics — tek kök ortam dosyası.
#   cp .env.example .env
# Gizli alanlar boştur. Gerçek değerleri yalnızca yerel .env içine yazın.
# Yayın arayüzleri yalnız 127.0.0.1 üzerindedir.
# Social (…11) ve tipik Sinapp portlarıyla çakışmamak için …27 kullanılır.
###############################################################################

HOST_PORT_FRONTEND=3027
HOST_PORT_BACKEND=8027
HOST_PORT_POSTGRES=5427
HOST_PORT_REDIS=6327
HOST_PORT_MAILHOG_SMTP=1027
HOST_PORT_MAILHOG_UI=8227
HOST_PORT_ZITADEL=8127

APP_NAME="Sinaptik Analytics"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

APP_URL=http://127.0.0.1:8027
FRONTEND_URL=http://127.0.0.1:3027
APP_DOMAIN=127.0.0.1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sinaptik_analytics
DB_USERNAME=sinaptik
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
CACHE_PREFIX=sinaptik_analytics
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:3027,localhost:3027

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@sinaptik.com.tr"
MAIL_FROM_NAME="${APP_NAME}"

IDENTITY_DRIVER=local
IDENTITY_LOCAL_ISSUER=local
# Yerel sürücüde owner/admin MFA korumasını geçmiş say. OIDC sürücüsünde yok sayılır.
IDENTITY_LOCAL_MFA=true
# Yerel Zitadel profili: http://127.0.0.1:8127
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Boşsa yönlendirme adresi {APP_URL}/auth/callback olur.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Zitadel'deki Google IdP kimliği. Boşsa authorize isteğine eklenmez.
OIDC_IDP_HINT=

# Yerel Zitadel (docker compose --profile sso). Gerçek değer yalnız .env içine yazılır.
# ZITADEL_MASTERKEY tam 32 karakter olmalıdır.
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_USERNAME=
ZITADEL_ADMIN_PASSWORD=

BILLING_GATEWAY=fake
SINAPP_BASE_URL=https://sinapp.com.tr
SINAPP_PURCHASE_PATH=/satin-al/sinaptik-analytics
SINAPP_INTEGRATION_KEY=
SINAPP_INTEGRATION_SECRET=
SINAPP_HUB_URL=https://sinapp.com.tr
SINAPP_HUB_CHECKOUT_PATH=/api/v1/checkout-sessions
SINAPP_HUB_KEY=
SINAPP_HUB_SECRET=
SINAPP_SIGNATURE_TOLERANCE=300

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CONSENT_TEXT_VERSION=
CONSENT_NOTICE_PATH=/aydinlatma-metni

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3027
API_PROXY_TARGET=http://backend:80
