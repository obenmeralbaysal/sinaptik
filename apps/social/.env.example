###############################################################################
# Sinapp Social — single source of truth for ALL services (backend, frontend,
# postgres, redis, mailhog, horizon, scheduler).
#
# Copy this file to `.env` at the repo root and fill in real values.
#   cp .env.example .env
#
# `docker compose` reads this file automatically. Backend (Laravel) and
# frontend (Next.js) containers receive every variable via `env_file: .env`.
###############################################################################

# ---------------------------------------------------------------------------
# Host ports
# Convention: ALL host-exposed ports end in `11` so nginx-proxy-manager (NPM)
# always proxies to a predictable 1xx11 range on the host.
# ---------------------------------------------------------------------------
HOST_PORT_FRONTEND=3011
HOST_PORT_BACKEND=8011
HOST_PORT_POSTGRES=5411
HOST_PORT_REDIS=6311
HOST_PORT_MAILHOG_SMTP=1011
HOST_PORT_MAILHOG_UI=8211

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME="Sinapp Social"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
PHP_CLI_SERVER_WORKERS=4

# Public URLs (what the browser / external X callback sees)
APP_URL=https://api.social.sinaptik.com.tr
FRONTEND_URL=https://social.sinaptik.com.tr

# Bare domains (used by NPM proxy host config — no scheme)
BACKEND_DOMAIN=api.social.sinaptik.com.tr
FRONTEND_DOMAIN=social.sinaptik.com.tr

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# DB_HOST is the docker service name, not 127.0.0.1.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sinapp
DB_USERNAME=sinapp
DB_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# Redis (cache + queue + session)
# ---------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password

CACHE_STORE=redis
CACHE_PREFIX=sinapp
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Session / Sanctum (production cookie config for cross-subdomain SPA)
# SESSION_DOMAIN must start with a leading dot to cover both subdomains.
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sinaptik.com.tr
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=social.sinaptik.com.tr

# ---------------------------------------------------------------------------
# Mail
# Dev: point to the mailhog container (MAIL_HOST=mailhog, MAIL_PORT=1025).
# Prod: switch to SendGrid / Resend / SMTP and set credentials.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sinaptik.com.tr"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# X (Twitter) OAuth 2.0 + PKCE
# Callback MUST match exactly what is registered in the X developer portal.
# ---------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=https://api.social.sinaptik.com.tr/api/social-accounts/x/callback

# ---------------------------------------------------------------------------
# Instagram (Graph API via Meta)  — Phase 2, placeholders ready
# ---------------------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CALLBACK_URL=https://api.social.sinaptik.com.tr/api/social-accounts/instagram/callback

# ---------------------------------------------------------------------------
# Facebook (Meta Graph API) — Phase 2, placeholders ready
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.social.sinaptik.com.tr/api/social-accounts/facebook/callback

# ---------------------------------------------------------------------------
# AI providers (gemini | openai)
# ---------------------------------------------------------------------------
AI_DRIVER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Payments (Phase 3 — stubbed by default)
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=null

# ---------------------------------------------------------------------------
# Frontend (Next.js) — exposed to the browser, so must be PUBLIC URLs.
# These are baked into the Next.js build via `NEXT_PUBLIC_*`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.social.sinaptik.com.tr
NEXT_PUBLIC_APP_URL=https://social.sinaptik.com.tr
