APP_NAME="Sinaptik Social"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sinsocial
DB_USERNAME=sinsocial_app
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,127.0.0.1:3021,social.sinaptik.com.tr

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@sinaptik.com.tr
MAIL_FROM_NAME="${APP_NAME}"

BILLING_GATEWAY=fake
SINAPP_BASE_URL=https://sinapp.com.tr
SINAPP_PURCHASE_PATH=/satin-al/sinaptik-social
SINAPP_INTEGRATION_KEY=
SINAPP_INTEGRATION_SECRET=
SINAPP_HUB_URL=https://sinapp.com.tr
SINAPP_HUB_KEY=
SINAPP_HUB_SECRET=

META_DRIVER=fake
COMMENT_RETENTION_DAYS=90
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v23.0
META_SYSTEM_USER_TOKEN=
META_CONSENT_TEXT_VERSION=v1
META_CONSENT_NOTICE_URL=/aydinlatma-metni

TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
MEDIA_DISK=media_local

ADMIN_EMAIL=
ADMIN_PASSWORD=
